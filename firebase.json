{
  "hosting": {
    "source": ".",
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "1GB"
    },
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "storage.rules",
      "firestore.indexes.json",
      ".env*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}